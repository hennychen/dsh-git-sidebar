{
  "name": "dsh-git-sidebar",
  "version": "0.7.3",
  "private": true,
  "description": "VS Code Source Control style multi-repository Git panel for the DeepSeek Harness right sidebar: repositories list with branch/ahead-behind/sync, changes with staging and commit, commit graph with repository picker and branch multi-select.",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "icon.svg",
  "author": "hennychen",
  "homepage": "https://github.com/hennychen/dsh-git-sidebar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hennychen/dsh-git-sidebar.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "source-control",
    "vscode",
    "sidebar"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/panel.png",
    "docs/cover.png",
    "docs/cover-3x2.png",
    "docs/cover-square.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
